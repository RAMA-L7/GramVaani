# GramVaani pilot backend environment (no secrets committed)
# Copy to .env and adjust locally as needed.

PILOT_HOST=127.0.0.1
PILOT_PORT=8010
PILOT_DB_PATH=pilot.db
PILOT_CONFIG_PATH=../config/pilot-fields.json
PILOT_AUDIO_TMP=.audio_tmp
PILOT_RETAIN_AUDIO_DEFAULT=false
PILOT_EVALUATION_RESULTS_DIR=../evaluation/results

# CORS origins (comma-separated)
PILOT_CORS_ORIGINS=http://localhost:3000,http://localhost:3010,http://127.0.0.1:3000,http://127.0.0.1:3010

# faster-whisper (local server-side ASR). Requires optional deps/model download.
FASTER_WHISPER_MODEL=small
FASTER_WHISPER_DEVICE=cpu
FASTER_WHISPER_COMPUTE_TYPE=int8
FASTER_WHISPER_DOWNLOAD_ROOT=

# Generic cloud HTTP ASR adapter (configure one provider; credentials required)
# Supported modes: google_stt, azure_speech, sarvam, generic
CLOUD_ASR_PROVIDER=
CLOUD_ASR_ENDPOINT=
CLOUD_ASR_API_KEY=
CLOUD_ASR_PROJECT_ID=
CLOUD_ASR_REGION=
CLOUD_ASR_LANGUAGE=te-IN
CLOUD_ASR_TIMEOUT_SECONDS=30
