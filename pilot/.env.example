# GramVaani pilot environment template (copy to .env; do not commit .env)
# Pilot runs separately from sandbox (sandbox: 8000/3000). Pilot defaults: 8010/3010.

# --- Backend ---
PILOT_BACKEND_HOST=127.0.0.1
PILOT_BACKEND_PORT=8010
PILOT_DATABASE_URL=sqlite:///./pilot.db
PILOT_LOG_LEVEL=INFO
# CORS origin for local frontend dev
PILOT_CORS_ORIGINS=http://localhost:3010

# --- Frontend ---
NEXT_PUBLIC_PILOT_API_BASE_URL=http://localhost:8010
PORT=3010

# --- ASR / evaluation (optional; required only for specific approaches) ---
# Do not commit real credentials. Prefer environment-injected secrets or local secret stores.
# ASR_PROVIDER=browser|local_faster_whisper|cloud
# FASTER_WHISPER_MODEL=small
# FASTER_WHISPER_DEVICE=cpu
# FASTER_WHISPER_COMPUTE_TYPE=int8
# CLOUD_ASR_PROVIDER=google|azure|sarvam
# CLOUD_ASR_API_KEY=
# CLOUD_ASR_ENDPOINT=

# --- Safety ---
# Pilot is research/prototype only: synthetic/non-identifying data in dev, no govt integration.
PILOT_ENV=local-dev
